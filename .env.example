# ─── Copy to .env and run `pnpm keys:generate` for the secret values ─────────
APP_ENV=local
APP_URL=http://localhost:3000
# ALLOWED_ORIGINS=https://admin.sipocot.gov.ph
LOG_LEVEL=debug
TRUST_PROXY=false

# Postgres (docker compose). On Vercel use a pooled URL (Neon/Supabase) and DATABASE_PREPARE=false, DATABASE_POOL_MAX=3.
DATABASE_URL=postgres://sipocot:sipocot@localhost:5432/sipocot_iam
DATABASE_POOL_MAX=10
DATABASE_PREPARE=true

# Redis (docker compose). On Vercel use Upstash/Redis Cloud: rediss://default:<password>@<host>:6379
REDIS_URL=redis://:sipocot@localhost:6379/0

# Encryption at rest (AES-256-GCM). Rotate: add a new key, switch ACTIVE id, keep old ones until re-encrypted.
ENCRYPTION_KEYS=
ENCRYPTION_ACTIVE_KEY_ID=
PASSWORD_PEPPER=

# Sessions & lockout
SESSION_ABSOLUTE_TTL_HOURS=168
SESSION_IDLE_TTL_MINUTES=120
SESSION_RETENTION_DAYS=30
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# S3 (SeaweedFS locally via docker compose). In AWS/Kubernetes omit the access keys and use IRSA / workload identity.
S3_BUCKET=sipocot-iam-files
S3_REGION=ap-southeast-1
S3_ENDPOINT=http://localhost:8333
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=sipocot
S3_SECRET_ACCESS_KEY=sipocot-secret
S3_SSE=none
S3_URL_TTL_SECONDS=300

# Monitoring & jobs
METRICS_TOKEN=
CRON_SECRET=
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Seed (pnpm db:seed)
SEED_ADMIN_EMAIL=admin@sipocot.gov.ph
SEED_ADMIN_PASSWORD=
