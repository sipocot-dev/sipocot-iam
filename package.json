{
  "name": "sipocot-iam",
  "version": "0.1.0",
  "private": true,
  "description": "Sipocot Identity & Access Management service",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --project unit --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db/migrate.ts",
    "db:seed": "tsx scripts/db/seed.ts",
    "keys:generate": "tsx scripts/generate-keys.ts",
    "audit:deps": "pnpm audit --prod --audit-level high",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1160.0",
    "@aws-sdk/s3-presigned-post": "3.1160.0",
    "@aws-sdk/s3-request-presigner": "3.1160.0",
    "@node-rs/argon2": "2.2.2",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/api-logs": "0.223.0",
    "@opentelemetry/instrumentation": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-logs": "0.223.0",
    "@opentelemetry/sdk-metrics": "2.12.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@vercel/otel": "2.1.4",
    "drizzle-orm": "0.45.4",
    "ioredis": "5.11.1",
    "next": "16.4.3",
    "pino": "10.4.0",
    "postgres": "3.4.9",
    "prom-client": "15.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "4.1.12",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "pino-pretty": "13.2.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "4.1.12"
  },
  "packageManager": "pnpm@10.34.8",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver",
      "@node-rs/argon2"
    ],
    "overrides": {
      "@esbuild-kit/core-utils>esbuild": "^0.25.0",
      "minimatch@>=7.0.0 <11.0.1": "^11.0.1"
    }
  }
}
